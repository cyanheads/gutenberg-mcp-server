# Paths `mcpb pack` leaves out of the bundle. It reads this file, not
# .gitignore, so gitignored local files ship unless they are listed here.
# Anchor every path with a leading "/": an unanchored name also strips the
# same name inside node_modules/. Root skills/ ships on purpose — it holds the
# skills this server publishes to installing agents.
.env*
.mcpregistry_*
/.claude/
/.agents/
/framework-skills/
/src/
# The catalog-mirror lifecycle scripts ship with the bundle (with
# tsconfig.runtime.json below), so `mirror:*` runs from an installed bundle.
# `/scripts/*`, not `/scripts/`: a negation cannot re-include a file whose
# parent directory is excluded.
/scripts/*
!/scripts/_mirror-context.ts
!/scripts/catalog-mirror-init.ts
!/scripts/catalog-mirror-refresh.ts
!/scripts/catalog-mirror-verify.ts
/tests/
/docs/
/changelog/
/coverage/
/logs/
/.cache/
/.mirror/
/.scratch/
/.github/
/.vscode/
/.claude-plugin/
/.codex-plugin/
/plugin.json
/mcp.json
/CLAUDE.md
/AGENTS.md
/Dockerfile
/.dockerignore
/.gitattributes
/devcheck.config.json
/bun.lock
/bunfig.toml
/wrangler.toml
/biome.json
/tsconfig*.json
!/tsconfig.runtime.json
/vitest.config.ts
